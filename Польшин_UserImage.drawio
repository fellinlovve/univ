ray></mxGeometry></mxCell><mxCell id="e9" value="репликация&lt;br&gt;основной → резервный" style="fontFamily=Times New Roman;html=1;rounded=0;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;exitPerimeter=0;entryPerimeter=0;endArrow=classic;endFill=1;startArrow=none;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="dbm" target="dbr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="nt" value="Запрос клиента идёт через вход и сервис к готовым репликам и не проходит через реестр образов. БД: основной экземпляр обслуживает запись, резервный получает копию изменений." style="text;fontFamily=Times New Roman;html=1;whiteSpace=wrap;fontSize=13;fontColor=#000000;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="820" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="p-tiers" name="Хранение_уровни"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="340" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="hot" value="Горячий уровень&lt;br&gt;быстрое хранение&lt;br&gt;недавние и часто нужные&lt;br&gt;файлы, выдача в пределах&lt;br&gt;цели p95 ≤ 300 мс" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;fontSize=14;fontColor=#000000;align=center;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="270" height="160" as="geometry"/></mxCell><mxCell id="cold" value="Холодный уровень&lt;br&gt;дешёвое хранение&lt;br&gt;старые файлы, к которым&lt;br&gt;редко обращаются" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;fontSize=14;fontColor=#000000;align=center;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="60" width="270" height="160" as="geometry"/></mxCell><mxCell id="e0" value="перенос по политике&lt;br&gt;(файл без обращений&lt;br&gt;90 дней — гипотеза)" style="fontFamily=Times New Roman;html=1;rounded=0;fontSize=13;labelBackgroundColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;exitX=1.0000;exitY=0.3000;entryX=0.0000;entryY=0.3000;exitPerimeter=0;entryPerimeter=0;endArrow=classic;endFill=1;startArrow=none;" edge="1" parent="1" source="hot" target="cold"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-34" as="offset"/></mxGeometry></mxCell><mxCell id="e1" value="извлечение по запросу" style="fontFamily=Times New Roman;html=1;rounded=0;fontSize=13;labelBackgroundColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;exitX=0.0000;exitY=0.7500;entryX=1.0000;entryY=0.7500;exitPerimeter=0;entryPerimeter=0;endArrow=classic;endFill=1;startArrow=none;" edge="1" parent="1" source="cold" target="hot"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="14" as="offset"/></mxGeometry></mxCell><mxCell id="nt" value="Старые файлы могут выдаваться медленнее: первое обращение к холодному файлу до 5 с (проектная цель, не подтверждена заказчиком). После извлечения файл снова попадает в горячий уровень. Решение записано в ADR-09." style="text;fontFamily=Times New Roman;html=1;whiteSpace=wrap;fontSize=14;fontColor=#000000;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="820" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="p-v3flow" name="V3_Потоки"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="1. Публичное чтение (только изображения с публичным доступом, TTL в CDN ≤ 60 с)" style="text;fontFamily=Times New Roman;html=1;whiteSpace=wrap;fontSize=14;fontColor=#000000;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="860" height="24" as="geometry"/></mxCell><mxCell id="a_cl" value="Клиент" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;fontSize=14;fontColor=#000000;align=center;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="110" height="60" as="geometry"/></mxCell><mxCell id="a_cdn" value="CDN" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;fontSize=14;fontColor=#000000;align=center;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="60" width="120" height="60" as="geometry"/></mxCell><mxCell id="a_in" value="Вход L7" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;fontSize=14;fontColor=#000000;align=center;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="400" y="60" width="120" height="60" as="geometry"/></mxCell><mxCell id="a_app" value="Приложение" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;fontSize=14;fontColor=#000000;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="60" width="130" height="60" as="geometry"/></mxCell><mxCell id="a_src" value="Источник:&lt;br&g