 style="fontFamily=Times New Roman;html=1;rounded=0;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;exitPerimeter=0;entryPerimeter=0;endArrow=classic;endFill=1;startArrow=none;" edge="1" parent="1" source="b_app" target="b_st"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-22" as="offset"/></mxGeometry></mxCell><mxCell id="e9" value="прав нет или нельзя проверить → отказ" style="fontFamily=Times New Roman;html=1;rounded=0;fontSize=13;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;strokeWidth=1.5;exitX=0.5000;exitY=1.0000;entryX=0.5000;entryY=1.0000;exitPerimeter=0;entryPerimeter=0;endArrow=classic;endFill=1;startArrow=none;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="b_app" target="b_cl"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480.0" y="450.0"/><mxPoint x="75.0" y="450.0"/></Array></mxGeometry></mxCell><mxCell id="t3" value="3. Загрузка и асинхронная обработка" style="text;fontFamily=Times New Roman;html=1;whiteSpace=wrap;fontSize=14;fontColor=#000000;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="495" width="860" height="24" as="geometry"/></mxCell><mxCell id="c_cl" value="Клиент" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;fontSize=14;fontColor=#000000;align=center;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="110" height="60" as="geometry"/></mxCell><mxCell id="c_in" value="Вход L7" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;fontSize=14;fontColor=#000000;align=center;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="560" width="120" height="60" as="geometry"/></mxCell><mxCell id="c_app" value="Приложение: проверка размера, формата, разре