опадание → выдача" style="fontFamily=Times New Roman;html=1;rounded=0;fontSize=13;labelBackgroundColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;exitX=0.5000;exitY=1.0000;entryX=0.5000;entryY=1.0000;exitPerimeter=0;entryPerimeter=0;endArrow=classic;endFill=1;startArrow=none;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="a_cdn" target="a_cl"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="260.0" y="160.0"/><mxPoint x="75.0" y="160.0"/></Array></mxGeometry></mxCell><mxCell id="t2" value="2. Защищённое чтение (всегда через проверку действующих прав, мимо общего CDN)" style="text;fontFamily=Times New Roman;html=1;whiteSpace=wrap;fontSize=14;fontColor=#000000;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="215" width="860" height="24" as="geometry"/></mxCell><mxCell id="b_cache" value="Внутренний кэш: метаданные и права,&lt;br&gt;TTL 30 с, при промахе — БД метаданных" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;fontSize=13;fontColor=#000000;align=center;verticalAlign=middle;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="255" width="320" height="55" as="geometry"/></mxCell><mxCell id="b_cl" value="Клиент" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;fontSize=14;fontColor=#000000;align=center;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="340" width="110" height="60" as="geometry"/></mxCell><mxCell id="b_in" value="Вход L7" style="fontFamily=Times New Roman;html=1;whiteSpace=wrap;fontSize=14;fontColor=#000000;align=center;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="340" width="120" height="60" as="geometry"/></mxCell><mxCell id="b_app" value="Приложение:&lt;br&gt;проверка действующих&l